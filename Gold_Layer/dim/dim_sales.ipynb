   "source": [
    "%sql\n",
    "create or replace table electronics_retailer_clg.gold.dim_sales AS\n",
    "SELECT DISTINCT\n",
    "    order_date AS date,\n",
    "    YEAR(order_date) AS year,\n",
    "    MONTH(order_date) AS month,\n",
    "    DAY(order_date) AS day\n",
    "from electronics_retailer_clg.silver.sales\n",
    "WHERE order_date IS NOT NULL;"
   ]
  }
